# ---------------------------------------------------------------------------
# saath-api — environment variable overrides
# Copy this file to .env and fill in real values.
# All variables use the SAATH__ prefix with __ as nested separator.
# ---------------------------------------------------------------------------

# -- LLM provider ------------------------------------------------------------
# Which provider to use: fake | openai | anthropic | google
SAATH__LLM__PROVIDER=fake

# Provider API keys (only one needed depending on SAATH__LLM__PROVIDER)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# Override model
SAATH__LLM__MODEL=gpt-4o-mini

# Per-request cost budget in USD (0.01 = 1 cent)
SAATH__LLM__BUDGET_USD=0.01

# -- Match feed adapter ------------------------------------------------------
SAATH__MATCH_FEED__BACKEND=fake
SAATH__MATCH_FEED__API_KEY=

# -- Cache -------------------------------------------------------------------
SAATH__CACHE__BACKEND=memory
SAATH__CACHE__REDIS_URL=redis://localhost:6379/0

# -- API server --------------------------------------------------------------
SAATH__API__HOST=0.0.0.0
SAATH__API__PORT=8000

# -- Logging -----------------------------------------------------------------
# Use "console" locally for human-readable output
SAATH__LOGGING__FORMAT=json
SAATH__LOGGING__LEVEL=INFO

# -- Config file path (optional) ---------------------------------------------
# Defaults to config.yaml in the working directory
SAATH__CONFIG_PATH=config.yaml
